task.spawn(function()
    local scriptId = "DatabaseScript"
    local scriptConfig = {
        Name = "Database Bloco Notas",
        Category = "Database Bloco Notas",
        GuiObject = ScreenGui,
        OnDestroy = function()
            -- [SPWN] Salva dados automaticamente antes de destruir (garante que nada se perde)
            pcall(salvarDadosLocais)
            -- Equivalente ao BotaoXSuperior / BotaoCloseCentral original
            pcall(function() ScreenGui:Destroy() end)
        end
    }

    -- Garante a persistência global na memória
    _G.ScriptManagerQueue = _G.ScriptManagerQueue or {}
    _G.RegisteredScriptDatabase = _G.RegisteredScriptDatabase or {}

    -- [SPWN] Lê visibilidade persistida em vez de hardcoded true
    local persistedVis = ScreenGui:GetAttribute("SPWN_ManagedVisibility")

    _G.RegisteredScriptDatabase[scriptId] = {
        Name = scriptConfig.Name,
        Category = scriptConfig.Category,
        GuiObject = scriptConfig.GuiObject,
        IsVisible = (persistedVis == nil) and true or persistedVis,
        OnDestroy = scriptConfig.OnDestroy
    }

    local exists = false
    for _, item in ipairs(_G.ScriptManagerQueue) do
        if item.id == scriptId then
            exists = true
            item.config = scriptConfig
            break
        end
    end
    if not exists then
        table.insert(_G.ScriptManagerQueue, {id = scriptId, config = scriptConfig})
    end

    if _G.ScriptManager and type(_G.ScriptManager.RegisterScript) == "function" then
        _G.ScriptManager.RegisterScript(scriptId, scriptConfig)
    end
end)
